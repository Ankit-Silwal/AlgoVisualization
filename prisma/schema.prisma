generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Experiment {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("experiments")
}
