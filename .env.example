# Local Docker Compose database. Replace this for your own PostgreSQL instance.
DATABASE_URL=postgresql://algo:algo_local_dev@localhost:5437/algovisualization?connect_timeout=3
# Build with npm run runner:build before enabling execution.
# Keep disabled on public deployments until authentication and isolation are configured.
RUNNER_ENABLED=false
# Start a separate worker with npm run worker.
REGISTRATION_ENABLED=true
# Enable only behind a proxy that overwrites incoming X-Forwarded-For headers.
TRUST_PROXY=false
# Production workers require gVisor installed on their Linux host:
# RUNNER_RUNTIME=runsc
